{
  "name": "demo-hugo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf content/graphql .markdown-copies public .site",
    "generate": "node ./scripts/generate-docs.mjs && node ./scripts/generate-copies.mjs",
    "dev": "npm run generate && hugo server -D",
    "build": "npm run generate && hugo && node -e \"require('node:fs').cpSync('.markdown-copies','public',{recursive:true})\"",
    "build:visual": "npm run generate && hugo --baseURL /demo-hugo/ -d .site/demo-hugo && node -e \"require('node:fs').cpSync('.markdown-copies','.site/demo-hugo',{recursive:true})\"",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@graphql-markdown/cli": "^1.3.1",
    "@graphql-markdown/formatters": "^1.3.1",
    "@graphql-markdown/graphql": "^1.4.1",
    "@graphql-markdown/printer-legacy": "^1.21.1",
    "@graphql-markdown/utils": "^1.14.5",
    "@graphql-tools/url-loader": "^10.0.9",
    "glob": "^14.0.6",
    "graphql": "^17.1.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.10.0",
    "@playwright/test": "^1.65.1",
    "serve": "^14.2.8"
  }
}
